{
  "name": "simulatte-studio",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "node scripts/stamp.mjs begin && pnpm --filter @simulatte/player build && pnpm --filter @simulatte/viewer build && node scripts/stamp.mjs",
    "dev": "pnpm --filter @simulatte/player build && pnpm --filter @simulatte/viewer exec vite --host 127.0.0.1",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0"
  }
}
